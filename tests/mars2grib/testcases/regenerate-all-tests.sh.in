#!/usr/bin/env bash
# Generated by CMake from tests/mars2grib/testcases/regenerate-all-tests.sh.in - do not edit.
#
# Regenerate the mars2grib test file with the current code (mars2grib-regenerate-tests) into
#     @CMAKE_CURRENT_BINARY_DIR@/regenerated/mars2grib-testcases-<md5>.ekbf
# No arguments.

set -u
if [ $# -ne 0 ]; then
    echo "usage: $0   (no arguments)" >&2
    exit 2
fi

out="@CMAKE_CURRENT_BINARY_DIR@/regenerated"
threads=$(nproc 2>/dev/null || echo 8)
rm -rf "$out"
mkdir -p "$out"

"$<TARGET_FILE:mars2grib-regenerate-tests>" \
    --input "@_testcases@" \
    --output "$out/mars2grib-testcases.ekbf" \
    --num-threads "$threads" \
    --keys "@_regen_keys@" \
    --records-per-block "@_regen_records_per_block@" \
    --zstd-level "@_regen_zstd_level@" \
    --failed-records "$out/failed-records.jsonl"
status=$?

# Name the new file after its MD5, as published on the sites repository.
if [ -f "$out/mars2grib-testcases.ekbf" ]; then
    md5=$(md5sum "$out/mars2grib-testcases.ekbf" | cut -c1-32)
    mv "$out/mars2grib-testcases.ekbf" "$out/mars2grib-testcases-$md5.ekbf"
    echo "New test file: $out/mars2grib-testcases-$md5.ekbf"
fi
exit $status
