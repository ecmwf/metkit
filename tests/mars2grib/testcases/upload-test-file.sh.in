#!/usr/bin/env bash
# Generated by CMake from tests/mars2grib/testcases/upload-test-file.sh.in - do not edit.
#
# Upload the regenerated test file
#     @CMAKE_CURRENT_BINARY_DIR@/regenerated/mars2grib-testcases-<md5>.ekbf
# to the Nexus repository `test-data`, directory `@_nexus_remote_path@`, with the ECMWF Nexus Toolkit,
# then check it by downloading it again. No arguments; asks for your Nexus username and password.

set -u
if [ $# -ne 0 ]; then
    echo "usage: $0   (no arguments)" >&2
    exit 2
fi

dir="@CMAKE_CURRENT_BINARY_DIR@/regenerated"
shopt -s nullglob
files=("$dir"/mars2grib-testcases-*.ekbf)
if [ ${#files[@]} -ne 1 ]; then
    echo "ERROR: expected exactly one $dir/mars2grib-testcases-<md5>.ekbf (run regenerate-all-tests.sh)" >&2
    exit 1
fi
file="${files[0]}"
name=$(basename "$file")
md5=${name#mars2grib-testcases-}
md5=${md5%.ekbf}
if [ "$(md5sum "$file" | cut -c1-32)" != "$md5" ]; then
    echo "ERROR: the MD5 of $file does not match its name" >&2
    exit 1
fi

if ! python3 -c "import nexus.toolkit" 2>/dev/null; then
    echo "ERROR: the Nexus Toolkit is not available to python3. Install it with:" >&2
    echo "   pip3 install --user nexus-get-toolkit -U -i https://get.ecmwf.int/repository/pypi-all/simple" >&2
    exit 1
fi

# Upload a directory holding only this file.
staging="$dir/upload"
rm -rf "$staging"
mkdir -p "$staging"
cp "$file" "$staging/"

code=$(cat <<'PY'
import getpass
import sys

from nexus.toolkit import Authenticator, FileManager, NexusExternalInstance

staging, remote = sys.argv[1], sys.argv[2]
username = input("Nexus username: ").strip()
password = getpass.getpass("Nexus password: ")
authenticator = Authenticator.from_credentials(username=username, password=password)
del password
nexus = NexusExternalInstance(authenticator=authenticator, repository="test-data")
FileManager(nexus=nexus).upload(local_path=staging + "/", remote_path=remote)
PY
)
python3 -c "$code" "$staging" "@_nexus_remote_path@"
status=$?
rm -rf "$staging"
if [ $status -ne 0 ]; then
    echo "ERROR: upload failed" >&2
    exit $status
fi

url="@_nexus_download_url@/$name"
echo "== checking $url"
if [ "$(curl -sSfL "$url" | md5sum | cut -c1-32)" != "$md5" ]; then
    echo "ERROR: downloading $url did not return the uploaded file" >&2
    exit 1
fi

echo "Uploaded and checked: $url"
echo "To use it in the ctests, in tests/mars2grib/testcases/CMakeLists.txt set:"
echo "   _default_url     \"@_nexus_download_url@\""
echo "   _default_version \"$md5\""
