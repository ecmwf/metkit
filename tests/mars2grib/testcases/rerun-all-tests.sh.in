#!/usr/bin/env bash
# Generated by CMake from tests/mars2grib/testcases/rerun-all-tests.sh.in - do not edit.
#
# Run all mars2grib corpus tests (encode, then decode) with mars2grib-run-tests and write one
# self-contained failure report per failed test (with its error stack) in place:
#     @CMAKE_CURRENT_BINARY_DIR@/failure-reports/<mode>/
# No arguments.

set -u
if [ $# -ne 0 ]; then
    echo "usage: $0   (no arguments)" >&2
    exit 2
fi

reports="@CMAKE_CURRENT_BINARY_DIR@/failure-reports"
threads=$(nproc 2>/dev/null || echo 8)
rm -rf "$reports"

status=0
for mode in encode decode; do
    mkdir -p "$reports/$mode"
    "$<TARGET_FILE:mars2grib-run-tests>" \
        --test-cases "@_testcases@" \
        --mode "$mode" \
        --num-threads "$threads" \
        --failure-reports --failure-reports-dir "$reports/$mode" \
        --failed-tests "$reports/$mode/failed-records" \
        --timings || status=1
done
exit $status
